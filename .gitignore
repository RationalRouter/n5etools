# Build outputs
/n5e
/n5e-ingest
/dist/
*.exe

# Rules DB copied into the embed source by `make embed-rules` — a build
# artifact, not source (see internal/embedded/embedded.go)
/internal/embedded/rules.db

# Databases built or created at runtime (rules DB is generated; characters.db is user data)
*.db
*.db-journal
*.db-wal
*.db-shm

# Extraction scratch output
/out/

# Windows icon/version-info resource generated by `go generate ./cmd/n5e`
# (see cmd/n5e/versioninfo.json) — a build artifact, not source.
/cmd/n5e/resource_windows.syso

# Zipped release packages built by `make release-windows`
/dist-release/

# Draft/reference source material for the static info pages — superseded
# by the actual templates (cmd/n5e/templates/{about,faq,technical,bugs}.html),
# not read by the app (not go:embed'd) or otherwise needed.
/content/

# Project-tracking/organizing docs and Claude Code config — kept locally
# as the project's working notes, not published.
/CLASS_AUDIT.md
/CLAUDE.md
/FEAT_AUDIT.md
/STATISTICS.md
/V2_ROADMAP.md
/.claude/

# Raw working notes from past sessions (unreferenced by any Go code —
# not test fixtures), kept locally only.
/testdata/
